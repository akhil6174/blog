# Copy to .dev.vars for local development. NEVER commit .dev.vars.
# In production set each with:  npx wrangler secret put NAME
# (Non-secret settings live in wrangler.jsonc "vars".)

# Phase 3: Google sign-in (Better Auth). From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Phase 3: harmful-content check (free endpoint, needs an OpenAI API key).
OPENAI_API_KEY=

# Phase 1: contact form + Phase 3 writer notifications.
RESEND_API_KEY=

# Phase 1: bot protection on forms. (The public TURNSTILE_SITE_KEY goes in wrangler.jsonc vars.)
TURNSTILE_SECRET_KEY=

# Phase 1: error alerts.
SENTRY_DSN=

# Local only: makes auth cookies non-secure and URLs local. Never set in production.
SITE_URL=http://127.0.0.1:4321
# Local only: enables the email/password form on /signin for testing without Google.
AUTH_DEV_LOGIN=true

# Step E: publishing your articles from the editor commits Markdown to GitHub (setup guide section 15).
# Fine-grained token, this repository only, permission "Contents: Read and write".
GITHUB_TOKEN=
# Local only: true = do not contact GitHub; keep the generated file in KV for inspection.
GITHUB_DRY_RUN=true
