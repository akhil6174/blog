{
  "name": "tech-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "postbuild": "pagefind --site dist/client",
    "check:content": "node scripts/check-content.mjs",
    "deploy": "wrangler d1 migrations apply tech-blog-db --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tech-blog-db --local",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/preact": "^6.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/extension-character-count": "^3.34.0",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-youtube": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "astro": "^7.4.10",
    "astro-og-canvas": "^0.13.3",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "lowlight": "^3.3.0",
    "lucide-preact": "^1.73.0",
    "preact": "^11.2.0",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.160.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "pagefind": "^1.6.0",
    "vitest": "^5.1.0"
  }
}
