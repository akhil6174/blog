---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Only shown for long posts; the caller decides (plan: over 1,200 words). */
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && (
  <nav aria-labelledby="toc-title" class="my-8 rounded-lg border border-line bg-surface p-5 font-sans text-sm">
    <p id="toc-title" class="font-semibold uppercase tracking-wide text-muted">In this article</p>
    <ol class="mt-3 space-y-1.5">
      {items.map((h) => (
        <li class:list={[h.depth === 3 && 'pl-4']}>
          <a href={`#${h.slug}`} class="text-ink hover:text-accent hover:underline">{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
