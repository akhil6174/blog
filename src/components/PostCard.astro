---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { formatDate, getAuthor, postUrl, readingMinutes, tagSlug } from '../lib/posts';

interface Props {
  post: Post;
  /** Larger card for the featured slot on the home page. */
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const author = await getAuthor(post);
const url = postUrl(post);
const minutes = readingMinutes(post.body);
---

<article class:list={['group flex flex-col gap-4', featured ? 'md:flex-row md:items-start md:gap-8' : '']}>
  {post.data.cover && (
    <a href={url} class:list={['block overflow-hidden rounded-lg border border-line bg-surface', featured ? 'md:w-1/2' : '']} tabindex="-1" aria-hidden="true">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes={featured ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
        class="aspect-[16/9] w-full object-cover transition group-hover:scale-[1.02]"
        loading={featured ? 'eager' : 'lazy'}
      />
    </a>
  )}
  <div class="flex flex-1 flex-col">
    <p class="font-sans text-xs font-semibold uppercase tracking-wide text-accent">
      {post.data.tags.slice(0, 2).map((t, i) => (
        <>
          {i > 0 && <span class="text-muted"> · </span>}
          <a href={`/tag/${tagSlug(t)}/`} class="hover:underline">{t}</a>
        </>
      ))}
    </p>
    <h2 class:list={['mt-2 font-sans font-bold leading-snug tracking-tight', featured ? 'text-2xl md:text-3xl' : 'text-xl']}>
      <a href={url} class="hover:underline decoration-2 underline-offset-4">{post.data.title}</a>
    </h2>
    <p class="mt-2 font-serif text-base leading-relaxed text-muted">{post.data.description}</p>
    <p class="mt-3 font-sans text-sm text-muted">
      <a href={`/author/${author.data.handle}/`} class="font-medium text-ink hover:underline">{author.data.name}</a>
      <span> · </span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span> · {minutes} min read</span>
    </p>
  </div>
</article>
