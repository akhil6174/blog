---
import { SITE } from '../lib/site';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/topics/', label: 'Topics' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href="/" class="font-sans text-xl font-bold tracking-tight" aria-label={`${SITE.name} home`}>{SITE.name}</a>

    <nav aria-label="Primary" class="flex items-center gap-1 font-sans text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded px-2.5 py-1.5 text-muted transition hover:bg-page hover:text-ink',
            isActive(item.href) && 'text-ink font-semibold',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/search/" class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded text-muted hover:bg-page hover:text-ink" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>
