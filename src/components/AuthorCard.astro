---
import { Image } from 'astro:assets';
import type { Author } from '../lib/posts';

interface Props {
  author: Author;
  /** Compact: inline byline under an article. Full: the box at the end of an article or on the author page. */
  variant?: 'compact' | 'full';
}
const { author, variant = 'full' } = Astro.props;
const a = author.data;
const links = Object.entries(a.links).filter(([, v]) => v) as [string, string][];
const labels: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', x: 'X', website: 'Website' };
---

{variant === 'compact' ? (
  <a href={`/author/${a.handle}/`} class="inline-flex items-center gap-2 font-sans text-sm">
    <Image src={a.avatar} alt={a.avatarAlt} width={64} height={64} class="h-8 w-8 rounded-full object-cover" />
    <span class="font-medium text-ink hover:underline">{a.name}</span>
  </a>
) : (
  <aside class="flex gap-4 rounded-lg border border-line bg-surface p-5">
    <Image src={a.avatar} alt={a.avatarAlt} width={160} height={160} class="h-16 w-16 shrink-0 rounded-full object-cover md:h-20 md:w-20" />
    <div class="font-sans">
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Written by</p>
      <p class="mt-1 text-lg font-bold"><a href={`/author/${a.handle}/`} class="hover:underline">{a.name}</a></p>
      <p class="text-sm text-muted">{a.role}</p>
      <p class="mt-2 font-serif text-base leading-relaxed">{a.bio}</p>
      {links.length > 0 && (
        <p class="mt-3 flex flex-wrap gap-3 text-sm">
          {links.map(([k, v]) => (
            <a href={v} rel="me noopener" target="_blank" class="text-accent hover:underline">{labels[k] ?? k}</a>
          ))}
        </p>
      )}
    </div>
  </aside>
)}
