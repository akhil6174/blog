---
import { CATEGORIES, SITE } from '../lib/site';
const year = new Date().getFullYear();
const site = [
  { href: '/articles/', label: 'Explore articles' },
  { href: '/students/', label: 'Student tools' },
  { href: '/topics/', label: 'Topics' },
  { href: '/top/', label: 'Top 10' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/rss.xml', label: 'RSS feed' },
];
const legal = [
  { href: '/privacy/', label: 'Privacy policy' },
  { href: '/terms/', label: 'Terms of use' },
  { href: '/disclaimer/', label: 'Disclaimer' },
  { href: '/editorial-policy/', label: 'Editorial policy' },
  { href: '/community-guidelines/', label: 'Community guidelines' },
];
---

<footer id="site-footer" class="border-t border-line bg-tint">
  <div class="mx-auto max-w-6xl px-4 py-12 font-sans text-sm text-muted">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <img src="/logo.svg" alt={SITE.name} width="125" height="30" class="h-7 w-auto" loading="lazy" />
        <p class="mt-3 leading-relaxed">{SITE.tagline}</p>
        <p class="mt-4">
          <a href={`mailto:${SITE.contactEmail}`} class="font-medium text-ink hover:text-accent">{SITE.contactEmail}</a><br />
          <a href={`mailto:${SITE.altEmail}`} class="hover:text-accent">{SITE.altEmail}</a>
        </p>
      </div>
      <nav aria-label="Topics">
        <p class="font-semibold text-ink">Topics</p>
        <ul class="mt-3 grid gap-2">{CATEGORIES.map((c) => <li><a href={`/articles/?category=${c.slug}`} class="hover:text-accent">{c.name}</a></li>)}</ul>
      </nav>
      <nav aria-label="Site">
        <p class="font-semibold text-ink">{SITE.name}</p>
        <ul class="mt-3 grid gap-2">{site.map((l) => <li><a href={l.href} class="hover:text-accent">{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Policies">
        <p class="font-semibold text-ink">Policies</p>
        <ul class="mt-3 grid gap-2">{legal.map((l) => <li><a href={l.href} class="hover:text-accent">{l.label}</a></li>)}</ul>
      </nav>
    </div>
    <p class="mt-10 border-t border-line pt-6">© {year} {SITE.name}. Published from India.</p>
  </div>
</footer>
