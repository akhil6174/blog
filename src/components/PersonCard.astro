---
/** One intern or ambassador on /people/ (and the admin preview): photo, name, role, college, period, summary, links. */
import type { PublicPerson } from '../lib/people';

interface Props { p: PublicPerson; badge: string }
const { p, badge } = Astro.props;
const initials = p.name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
const links = [
  p.github && { href: p.github, label: 'GitHub' },
  p.linkedin && { href: p.linkedin, label: 'LinkedIn' },
  p.website && { href: p.website, label: 'Website' },
  p.profileUrl && { href: p.profileUrl, label: 'Articles' },
].filter(Boolean) as { href: string; label: string }[];
---

<article class="flex flex-col rounded-2xl border border-line bg-surface p-5 font-sans" data-person={p.name}>
  <div class="flex items-center gap-4">
    {p.photo
      ? <img src={p.photo} alt={`Photo of ${p.name}`} width="72" height="72" loading="lazy" class="h-[72px] w-[72px] shrink-0 rounded-full object-cover" referrerpolicy="no-referrer" />
      : <span class="flex h-[72px] w-[72px] shrink-0 items-center justify-center rounded-full bg-tint text-xl font-bold text-accent-strong" aria-hidden="true">{initials}</span>}
    <div class="min-w-0">
      <h3 class="text-lg font-bold leading-tight text-ink">{p.name}</h3>
      {p.role && <p class="text-sm text-ink">{p.role}</p>}
      {p.college && <p class="text-sm text-muted">{p.college}</p>}
    </div>
  </div>
  <p class="mt-3 flex flex-wrap items-center gap-2 text-xs">
    <span class="rounded-full bg-tint px-2.5 py-0.5 font-semibold text-accent-strong">{badge}</span>
    {p.period && <span class="text-muted">{p.period}</span>}
  </p>
  {p.summary && <p class="mt-3 text-sm leading-relaxed text-ink">{p.summary}</p>}
  {p.highlightUrl && <p class="mt-3 text-sm"><a href={p.highlightUrl} target="_blank" rel="noopener" class="font-semibold text-accent underline">{p.highlightLabel || 'See their work'} →</a></p>}
  {links.length > 0 && (
    <p class="mt-auto flex flex-wrap gap-2 pt-4 text-sm">
      {links.map((l) => <a href={l.href} target={l.href.startsWith('/') ? undefined : '_blank'} rel={l.href.startsWith('/') ? undefined : 'noopener nofollow'} class="rounded-full border border-line px-3 py-1 text-ink hover:border-accent hover:text-accent">{l.label}</a>)}
    </p>
  )}
</article>
