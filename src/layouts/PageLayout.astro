---
/**
 * PageLayout: for static text pages (About, legal, policies). Title + optional intro + prose body.
 */
import BaseLayout from './BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  intro?: string;
  updated?: string;
  noindex?: boolean;
}
const { title, description, intro, updated, noindex = false } = Astro.props;
const siteUrl = (Astro.site ?? new URL('https://trutiai.in/')).href;
const crumbs = breadcrumbJsonLd([
  { name: 'Home', url: siteUrl },
  { name: title, url: new URL(Astro.url.pathname, siteUrl).href },
]);
---

<BaseLayout title={title} description={description} noindex={noindex} jsonLd={[crumbs]}>
  <article class="mx-auto max-w-measure">
    <header class="mb-8 border-b border-line pb-6">
      <h1 class="font-sans text-3xl font-bold leading-tight tracking-tight md:text-4xl">{title}</h1>
      {intro && <p class="mt-3 font-serif text-lg text-muted">{intro}</p>}
      {updated && <p class="mt-3 font-sans text-sm text-muted">Last updated: {updated}</p>}
    </header>
    <div class="prose prose-article">
      <slot />
    </div>
  </article>
</BaseLayout>
