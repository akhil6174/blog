---
/**
 * Article page (static). Everything an AdSense reviewer and Googlebot expect on an article:
 * byline with dates, reading time, table of contents for long posts, author box, related posts,
 * Article + BreadcrumbList JSON-LD, Open Graph share image, prev/next links. Ad slots render only in Phase 4.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import PostCard from '../../components/PostCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AdSlot from '../../components/AdSlot.astro';
import { formatDate, getAuthor, getPublishedPosts, postUrl, readingMinutes, relatedPosts, tagSlug, wordCount } from '../../lib/posts';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null, all: posts },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const author = await getAuthor(post);
const words = wordCount(post.body);
const minutes = readingMinutes(post.body);
const related = relatedPosts(post, all);
const siteUrl = (Astro.site ?? new URL('https://trutiai.in/')).href;
const url = new URL(postUrl(post), siteUrl).href;
const ogImage = `/og/${post.id}.png`;

const jsonLd = [
  articleJsonLd(siteUrl, {
    url,
    title: post.data.title,
    description: post.data.description,
    image: new URL(ogImage, siteUrl).href,
    published: post.data.pubDate,
    updated: post.data.updatedDate,
    authorName: author.data.name,
    authorUrl: `${siteUrl}author/${author.data.handle}/`,
    tags: post.data.tags,
    wordCount: words,
  }),
  breadcrumbJsonLd([
    { name: 'Home', url: siteUrl },
    { name: post.data.tags[0], url: `${siteUrl}tag/${tagSlug(post.data.tags[0])}/` },
    { name: post.data.title, url },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={ogImage}
  imageAlt={post.data.title}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-measure" data-pagefind-body>
    <header class="mb-8">
      <p class="font-sans text-xs font-semibold uppercase tracking-wide text-accent">
        {post.data.tags.map((t, i) => (
          <>
            {i > 0 && <span class="text-muted"> · </span>}
            <a href={`/tag/${tagSlug(t)}/`} class="hover:underline">{t}</a>
          </>
        ))}
      </p>
      <h1 class="mt-3 font-sans text-3xl font-bold leading-tight tracking-tight md:text-4xl">{post.data.title}</h1>
      <p class="mt-4 font-serif text-lg leading-relaxed text-muted">{post.data.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-sans text-sm text-muted">
        <AuthorCard author={author} variant="compact" />
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
    </header>

    {post.data.cover && (
      <figure class="mb-8">
        <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[680, 1000, 1360]} sizes="(min-width: 768px) 680px, 100vw" class="w-full rounded-lg border border-line" loading="eager" fetchpriority="high" />
      </figure>
    )}

    {words > 1200 && <TableOfContents headings={headings} />}

    <div class="prose prose-article">
      <Content />
    </div>

    <AdSlot slot="" height={280} />

    <footer class="mt-12 space-y-10">
      <AuthorCard author={author} />

      {(newer || older) && (
        <nav aria-label="Adjacent articles" class="grid gap-4 font-sans text-sm sm:grid-cols-2">
          {newer ? (
            <a href={postUrl(newer)} rel="prev" class="rounded-lg border border-line bg-surface p-4 hover:border-accent">
              <span class="text-xs uppercase tracking-wide text-muted">Newer</span>
              <span class="mt-1 block font-semibold">{newer.data.title}</span>
            </a>
          ) : <span />}
          {older && (
            <a href={postUrl(older)} rel="next" class="rounded-lg border border-line bg-surface p-4 text-right hover:border-accent">
              <span class="text-xs uppercase tracking-wide text-muted">Older</span>
              <span class="mt-1 block font-semibold">{older.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>

  {related.length > 0 && (
    <section aria-labelledby="related-title" class="mx-auto mt-16 max-w-5xl border-t border-line pt-10">
      <h2 id="related-title" class="mb-6 font-sans text-xs font-semibold uppercase tracking-wide text-muted">Continue reading</h2>
      <div class="grid gap-10 md:grid-cols-3">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
