---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, tagSummaries } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = tagSummaries(posts);
---

<BaseLayout title="Topics" description="Browse every topic on TrutiAI: tutorials, tool comparisons and explainers grouped by subject.">
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">Topics</h1>
  <p class="mt-3 max-w-2xl font-serif text-lg text-muted">Every article is tagged with up to five topics. Pick one to see all the articles on it.</p>
  <ul class="mt-8 grid gap-3 font-sans sm:grid-cols-2 md:grid-cols-3">
    {tags.map((t) => (
      <li>
        <a href={`/tag/${t.slug}/`} class="flex items-center justify-between rounded-lg border border-line bg-surface px-4 py-3 hover:border-accent">
          <span class="font-semibold">{t.tag}</span>
          <span class="text-sm text-muted">{t.count} {t.count === 1 ? 'article' : 'articles'}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
