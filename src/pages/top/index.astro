---
/**
 * /top : Top 10 by engagement for today, this month, this year. Lists are computed hourly by cron into KV;
 * this page costs one KV read per window (plan, Part 2). Editorial titles come from the content collection.
 */
import { env } from 'cloudflare:workers';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TopEntry } from '../../cron/hourly';
import { getSettingBool } from '../../lib/db/settings';

export const prerender = false;

const open = await getSettingBool('community_open');
const windows = [['today', 'Today'], ['month', 'This month'], ['year', 'This year']] as const;
const editorial = new Map((await getCollection('posts', ({ data }) => !data.draft)).map((p) => [p.id, p.data.title]));

const lists: Record<string, { at: string; list: TopEntry[] }> = {};
for (const [w] of windows) {
  const raw = await env.CACHE.get(`top:${w}`);
  lists[w] = raw ? JSON.parse(raw) : { at: '', list: [] };
}
const resolve = (e: TopEntry) => (e.editorial ? { title: editorial.get(e.editorial) ?? e.editorial, url: `/blog/${e.editorial}/` } : { title: e.title ?? e.slug ?? e.postId, url: `/p/${e.slug}/` });
// Editorial articles that were removed from the site are skipped (their old view counts stay in the hourly list until it refreshes).
const visible = (e: TopEntry) => (e.editorial ? editorial.has(e.editorial) : open);
---

<BaseLayout title="Top 10 articles" description="The most read, raised and discussed articles on TrutiAI today, this month and this year, updated every hour.">
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">Top 10</h1>
  <p class="mt-3 max-w-2xl font-serif text-lg text-muted">Ranked by reads, raises and comments. Updated every hour.</p>

  <div class="mt-8 grid gap-10 lg:grid-cols-3" id="top-lists">
    {windows.map(([w, label]) => {
      const items = lists[w].list.filter(visible).slice(0, 10);
      return (
        <section aria-labelledby={`top-${w}`}>
          <h2 id={`top-${w}`} class="mb-4 font-sans text-xs font-semibold uppercase tracking-wide text-muted">{label}</h2>
          {items.length === 0 ? (
            <p class="font-serif text-sm text-muted">Not enough activity yet.</p>
          ) : (
            <ol class="space-y-3 font-sans">
              {items.map((e, i) => {
                const r = resolve(e);
                return (
                  <li class="flex gap-3 rounded-lg border border-line bg-surface p-3">
                    <span class="w-6 shrink-0 text-right text-lg font-bold text-muted">{i + 1}</span>
                    <div class="min-w-0">
                      <a href={r.url} class="font-semibold hover:underline">{r.title}</a>
                      <p class="text-xs text-muted">{e.views} reads · {e.raises} raises · {e.comments} comments</p>
                    </div>
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>
