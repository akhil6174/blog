---
/**
 * /p/<slug> : a community article (on-demand, edge-cached 10 min by the middleware, purged on edit).
 * Visible only when published and (community_open OR the viewer is the author/admin).
 * noindex until moderation set index_allowed AND the community is open. Ads only when ads_allowed (Phase 4).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import TechDetails from '../../components/TechDetails.astro';
import { parseTech } from '../../lib/tech';
import CommunityCard from '../../components/CommunityCard.astro';
import CommentList from '../../components/CommentList.astro';
import CommentForm from '../../islands/CommentForm';
import RaiseButton from '../../islands/RaiseButton';
import ReportButton from '../../islands/ReportButton';
import { getPublishedBySlug, relatedCommunity } from '../../lib/community';
import { getSettingBool } from '../../lib/db/settings';
import { formatDate } from '../../lib/posts';
import { categoryName } from '../../lib/site';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { headings as docHeadings } from '../../lib/render-doc';

export const prerender = false;

const post = await getPublishedBySlug(Astro.params.slug!);
const open = await getSettingBool('community_open');
let allowed = !!post && post.status === 'published' && open;
if (post && !allowed) {
  // Author or admin may preview an unlisted/unpublished post.
  const { auth, hasRole } = await import('../../lib/auth');
  const s = await auth().api.getSession({ headers: Astro.request.headers });
  allowed = !!s?.user && (s.user.id === post.authorId || hasRole(s.user, 'admin')) && ['published', 'pending_review', 'hidden', 'unpublished'].includes(post.status);
  if (allowed) Astro.response.headers.set('cache-control', 'private, no-store');
}
if (!post || !allowed) return new Response(null, { status: 404 });

const siteUrl = (Astro.site ?? new URL('https://trutiai.in/')).href;
const cat = categoryName(post.category);
const url = `${siteUrl}p/${post.slug}/`;
const noindex = !(post.indexAllowed && open && post.status === 'published');
const related = await relatedCommunity(post);
const toc = post.wordCount > 1200 ? docHeadings(JSON.parse(post.bodyJson)).filter((h) => h.depth <= 3) : [];
const turnstileSiteKey = process.env.TURNSTILE_SITE_KEY ?? '';

const jsonLd = noindex ? [] : [
  articleJsonLd(siteUrl, { url, title: post.title, description: post.description ?? '', image: post.coverImage ?? undefined, published: post.publishedAt ?? post.createdAt, updated: post.updatedAt, authorName: post.author.name, authorUrl: post.author.handle ? `${siteUrl}writer/${post.author.handle}/` : siteUrl, tags: post.tags.map((t) => t.name), wordCount: post.wordCount }),
  breadcrumbJsonLd([{ name: 'Home', url: siteUrl }, { name: 'Community', url: `${siteUrl}community/` }, ...(cat ? [{ name: cat, url: `${siteUrl}community/?category=${post.category}` }] : []), { name: post.title, url }]),
];
---

<BaseLayout title={post.seoTitle || post.title} description={post.description ?? post.title} type="article" image={post.coverImage ?? '/og-default.png'} imageAlt={post.coverAlt ?? post.title} publishedTime={post.publishedAt ?? undefined} modifiedTime={post.updatedAt} noindex={noindex} jsonLd={jsonLd}>
  <article class="mx-auto max-w-measure">
    {post.status !== 'published' && <p class="mb-6 rounded border border-amber-300 bg-amber-50 p-3 font-sans text-sm text-amber-900">Preview: this article is <strong>{post.status.replace('_', ' ')}</strong> and not visible to readers.</p>}
    <header class="mb-8">
      <p class="font-sans text-xs font-semibold uppercase tracking-wide text-accent">
        <a href="/community/" class="hover:underline">Community</a>
        {cat && <><span class="text-muted"> · </span><a href={`/community/?category=${post.category}`} class="hover:underline">{cat}</a></>}
        {post.tags.map((t) => (<><span class="text-muted"> · </span><a href={`/community/?tag=${t.slug}`} class="hover:underline">{t.name}</a></>))}
      </p>
      <h1 class="mt-3 font-sans text-3xl font-bold leading-tight tracking-tight md:text-4xl">{post.title}</h1>
      {post.subtitle && <p class="mt-3 font-serif text-xl text-muted">{post.subtitle}</p>}
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-sans text-sm text-muted">
        {post.author.image && <img src={post.author.image} alt="" width="32" height="32" class="h-8 w-8 rounded-full" referrerpolicy="no-referrer" />}
        {post.author.handle ? <a href={`/writer/${post.author.handle}/`} class="font-medium text-ink hover:underline">{post.author.name}</a> : <span class="font-medium text-ink">{post.author.name}</span>}
        <span aria-hidden="true">·</span>
        {post.publishedAt && <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time>}
        <span aria-hidden="true">·</span><span>{post.readingMinutes} min read</span>
      </div>
    </header>

    {post.coverImage && <figure class="mb-8"><img src={post.coverImage} alt={post.coverAlt ?? ''} class="w-full rounded-lg border border-line" referrerpolicy="no-referrer" /></figure>}

    <TechDetails tech={parseTech(post.techMeta)} />

    {toc.length >= 3 && (
      <nav aria-label="In this article" class="my-8 rounded-lg border border-line bg-surface p-5 font-sans text-sm">
        <p class="font-semibold uppercase tracking-wide text-muted">In this article</p>
        <ol class="mt-3 space-y-1.5">{toc.map((h) => <li class:list={[h.depth === 3 && 'pl-4']}><a href={`#${h.slug}`} class="hover:text-accent hover:underline">{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose prose-article" set:html={post.bodyHtml} />

    {post.adsAllowed && <AdSlot slot="" height={280} />}

    <footer class="mt-10 flex flex-wrap items-center gap-4 border-t border-line pt-6 font-sans text-sm">
      <RaiseButton client:load postId={post.id} initial={post.raisesCount} />
      <ReportButton client:visible targetType="post" targetId={post.id} />
      <span class="ml-auto text-muted">Community article · <a href="/community-guidelines/" class="underline">guidelines</a></span>
    </footer>

    <aside class="mt-10 flex gap-4 rounded-lg border border-line bg-surface p-5 font-sans">
      {post.author.image && <img src={post.author.image} alt="" width="64" height="64" class="h-16 w-16 shrink-0 rounded-full" referrerpolicy="no-referrer" />}
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted">Written by</p>
        <p class="mt-1 text-lg font-bold">{post.author.handle ? <a href={`/writer/${post.author.handle}/`} class="hover:underline">{post.author.name}</a> : post.author.name}</p>
        {post.author.bio && <p class="mt-2 font-serif text-base leading-relaxed">{post.author.bio}</p>}
      </div>
    </aside>

    <section class="mt-12" aria-labelledby="comments-title">
      <h2 id="comments-title" class="font-sans text-xs font-semibold uppercase tracking-wide text-muted">Comments</h2>
      <CommentList server:defer postId={post.id}><p slot="fallback" class="mt-3 font-sans text-sm text-muted">Loading comments…</p></CommentList>
      <CommentForm client:visible postId={post.id} turnstileSiteKey={turnstileSiteKey} />
    </section>
  </article>

  {related.length > 0 && (
    <section class="mx-auto mt-16 max-w-5xl border-t border-line pt-10">
      <h2 class="mb-6 font-sans text-xs font-semibold uppercase tracking-wide text-muted">More from the community</h2>
      <div class="grid gap-10 md:grid-cols-3">{related.map((p) => <CommunityCard post={p} />)}</div>
    </section>
  )}

  <script is:inline define:vars={{ postId: post.id }}>
    setTimeout(() => { try { navigator.sendBeacon('/api/view', new Blob([JSON.stringify({ postId })], { type: 'application/json' })); } catch {} }, 10000);
  </script>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
