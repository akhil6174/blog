---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';

const author = await getEntry('authors', 'akhil');
if (!author) throw new Error('Author "akhil" missing');
const a = author.data;
---

<PageLayout
  title={`About ${SITE.name}`}
  description={`${SITE.name} is an independent tech blog by ${a.name}: practical tutorials, honest tool comparisons and clear explainers for developers.`}
  intro={SITE.tagline}
>
  <h2>What this site is</h2>
  <p>
    {SITE.name} is an independent publication about building software. Every article is written from hands-on
    experience: the code has been run, the tools have been installed, and the numbers have been checked against
    official sources. We write for working developers and for people learning the craft, in plain English.
  </p>

  <h2>What we cover</h2>
  <ul>
    {SITE.topics.map((t) => <li>{t}</li>)}
  </ul>

  <h2>Who writes it</h2>
  <div class="not-prose my-6 flex items-start gap-5 rounded-lg border border-line bg-surface p-5 font-sans">
    <Image src={a.avatar} alt={a.avatarAlt} width={200} height={200} class="h-24 w-24 shrink-0 rounded-full object-cover" />
    <div>
      <p class="text-lg font-bold">{a.name}</p>
      <p class="text-sm text-muted">{a.role}</p>
      <p class="mt-2 font-serif text-base leading-relaxed">{a.bio}</p>
      <p class="mt-3 text-sm"><a href={`/author/${a.handle}/`} class="text-accent underline">All articles by {a.name}</a></p>
    </div>
  </div>
  <p>
    Community writers will be able to publish here too. Their articles carry their own byline and pass the same
    editorial checks; see the <a href="/community-guidelines/">community guidelines</a>.
  </p>

  <h2>How we work</h2>
  <ul>
    <li><strong>Tested, not summarised.</strong> We do not republish documentation or other sites' articles.</li>
    <li><strong>Transparent.</strong> Where AI tools helped with a draft, diagram or code review, the article says so. Our <a href="/editorial-policy/">editorial policy</a> has the details.</li>
    <li><strong>Corrected in the open.</strong> Mistakes are fixed in place with an updated date. Spotted one? <a href="/contact/">Tell us</a>.</li>
    <li><strong>Independent.</strong> No sponsored posts without a clear label. See the <a href="/disclaimer/">disclaimer</a>.</li>
  </ul>

  <h2>Contact</h2>
  <p>Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> or use the <a href="/contact/">contact form</a>. {SITE.name} is published from India.</p>
</PageLayout>
