---
/**
 * /leaderboard : published monthly results (top 10 with scores and prizes, top three highlighted), earlier
 * winners, and this month's most upvoted articles so far (live, not final). Public only while `programme_open`.
 */
import { and, desc, eq, gte, lt, ne, sql } from 'drizzle-orm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewBanner from '../../components/PreviewBanner.astro';
import { db, posts, raises, user } from '../../lib/db';
import { listEntries, monthLabel, monthOf, monthRange, programmeGate, publishedMonths, rupees } from '../../lib/programme';

export const prerender = false;
const cfg = await programmeGate(Astro.request.headers);
if (!cfg) return new Response(null, { status: 404 });
if (cfg.preview) Astro.response.headers.set('cache-control', 'private, no-store');

const months = await publishedMonths();
const latest = months[0];
const results = latest ? (await listEntries(latest)).filter((e) => e.rank).slice(0, 10) : [];
const earlier = [];
for (const m of months.slice(1, 7)) earlier.push({ month: m, top: (await listEntries(m)).filter((e) => e.rank && e.rank <= 3) });

// Live: this month's published community articles by upvotes from other accounts.
const now = monthOf(new Date());
const { from, to } = monthRange(now);
const d = db();
const live = await d
  .select({ id: posts.id, title: posts.title, slug: posts.slug, author: user.name, handle: user.handle, votes: sql<number>`count(${raises.userId})` })
  .from(posts)
  .innerJoin(user, eq(user.id, posts.authorId))
  .leftJoin(raises, and(eq(raises.postId, posts.id), ne(raises.userId, posts.authorId)))
  .where(and(eq(posts.status, 'published'), eq(posts.kind, 'community'), gte(posts.publishedAt, from), lt(posts.publishedAt, to)))
  .groupBy(posts.id)
  .orderBy(desc(sql`count(${raises.userId})`), desc(posts.publishedAt))
  .limit(10);
const medal = ['bg-amber-100 border-amber-300', 'bg-slate-100 border-slate-300', 'bg-orange-100 border-orange-300'];
const pts = (s: number | null) => (s === null ? '–' : (s / 10).toFixed(1));
---

<BaseLayout title="Monthly leaderboard" description="The Campus Writers Programme monthly results: top articles, final scores and prizes on TrutiAI.">
  {cfg.preview && <PreviewBanner />}
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">Monthly leaderboard</h1>
  <p class="mt-3 max-w-2xl font-serif text-lg text-muted">Final scores combine an editor's marks for accuracy, depth, originality and clarity with genuine reader upvotes. <a href="/reward-policy/" class="underline">How scoring works</a></p>

  {latest ? (
    <section class="mt-10 font-sans" aria-labelledby="results-title">
      <h2 id="results-title" class="text-xl font-bold">{monthLabel(latest)} results</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {results.slice(0, 3).map((e, i) => (
          <div class:list={['rounded-lg border p-5', medal[i]]}>
            <p class="text-sm font-semibold">#{e.rank}</p>
            <a href={`/p/${e.slug}/`} class="mt-1 block text-lg font-bold leading-snug hover:underline">{e.title}</a>
            <p class="mt-1 text-sm">{e.authorHandle ? <a href={`/writer/${e.authorHandle}/`} class="hover:underline">{e.authorName}</a> : e.authorName}</p>
            <p class="mt-3 text-sm">Score {pts(e.score)} · {e.upvotes} upvotes{e.prize > 0 && <> · <strong>{rupees(e.prize)}</strong></>}</p>
          </div>
        ))}
      </div>
      {results.length > 3 && (
        <div class="mt-4 overflow-x-auto rounded-lg border border-line bg-surface">
          <table class="w-full text-left text-sm">
            <thead class="text-xs text-muted"><tr><th class="p-3">Rank</th><th class="p-3">Article</th><th class="p-3">Writer</th><th class="p-3">Upvotes</th><th class="p-3">Score</th><th class="p-3">Prize</th></tr></thead>
            <tbody class="divide-y divide-line">
              {results.slice(3).map((e) => <tr><td class="p-3">#{e.rank}</td><td class="p-3"><a href={`/p/${e.slug}/`} class="hover:underline">{e.title}</a></td><td class="p-3">{e.authorName}</td><td class="p-3">{e.upvotes}</td><td class="p-3">{pts(e.score)}</td><td class="p-3">{e.prize ? rupees(e.prize) : '–'}</td></tr>)}
            </tbody>
          </table>
        </div>
      )}
    </section>
  ) : (
    <p class="mt-10 rounded-lg border border-line bg-surface p-5 font-sans text-sm text-muted">The first results are published after the first month of the programme ends.</p>
  )}

  <section class="mt-12 font-sans" aria-labelledby="live-title">
    <h2 id="live-title" class="text-xl font-bold">{monthLabel(now)} so far</h2>
    <p class="mt-1 text-sm text-muted">Most upvoted articles this month. Not final: editor scores are added when the month ends.</p>
    {live.length === 0 ? <p class="mt-3 text-sm text-muted">No articles published this month yet.</p> : (
      <ol class="mt-4 space-y-2">
        {live.map((p, i) => <li class="flex gap-3 rounded-lg border border-line bg-surface p-3"><span class="w-6 text-right font-bold text-muted">{i + 1}</span><span class="min-w-0 flex-1"><a href={`/p/${p.slug}/`} class="font-semibold hover:underline">{p.title}</a><span class="block text-xs text-muted">{p.author}</span></span><span class="shrink-0 text-sm text-muted">{Number(p.votes)} upvotes</span></li>)}
      </ol>
    )}
  </section>

  {earlier.length > 0 && (
    <section class="mt-12 font-sans" aria-labelledby="past-title">
      <h2 id="past-title" class="text-xl font-bold">Previous winners</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {earlier.map((m) => (
          <div class="rounded-lg border border-line bg-surface p-4">
            <p class="font-semibold">{monthLabel(m.month)}</p>
            <ol class="mt-2 space-y-1 text-sm">{m.top.map((e) => <li>#{e.rank} <a href={`/p/${e.slug}/`} class="hover:underline">{e.title}</a> <span class="text-muted">· {e.authorName}</span></li>)}</ol>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
