---
/**
 * /community : published community posts (on-demand, edge-cached by the middleware).
 * Hidden (404) while the `community_open` flag is false: invited writers test via their own status pages.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityCard from '../../components/CommunityCard.astro';
import { listPublished, countPublished } from '../../lib/community';
import { getSettingBool } from '../../lib/db/settings';
import { CATEGORIES, categoryName } from '../../lib/site';

export const prerender = false;

const open = await getSettingBool('community_open');
if (!open) return new Response(null, { status: 404 });

const PER = 12;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1);
const tag = Astro.url.searchParams.get('tag') ?? undefined;
const category = Astro.url.searchParams.get('category') ?? undefined;
const catName = categoryName(category);
const items = await listPublished({ limit: PER, offset: (page - 1) * PER, tag, category: catName ? category : undefined });
const total = tag || catName ? items.length : await countPublished();
const pages = Math.max(1, Math.ceil(total / PER));
---

<BaseLayout title={catName ? `Community: ${catName}` : tag ? `Community: ${tag}` : 'Community articles'} description="Articles written by the TrutiAI community: tutorials, opinions and explainers from developers, checked before publishing." noindex={page > 1 || !!tag || !!catName}>
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">Community{(catName || tag) && <span class="text-muted"> · {catName ?? tag}</span>}</h1>
  <p class="mt-3 max-w-2xl font-serif text-lg text-muted">Written by readers like you and checked before publishing. <a href="/write/" class="underline">Write your own</a>.</p>
  <nav aria-label="Categories" class="mt-6 flex flex-wrap gap-2 font-sans text-sm">
    <a href="/community/" class:list={['rounded-full border px-3 py-1', !catName ? 'border-accent text-ink' : 'border-line text-muted hover:text-ink']}>All</a>
    {CATEGORIES.map((c) => <a href={`/community/?category=${c.slug}`} class:list={['rounded-full border px-3 py-1', category === c.slug ? 'border-accent text-ink' : 'border-line text-muted hover:text-ink']}>{c.name}</a>)}
  </nav>
  {items.length === 0 ? (
    <p class="mt-10 font-serif text-muted">No community articles yet. Be the first: <a href="/write/" class="underline">start writing</a>.</p>
  ) : (
    <div class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-3">{items.map((p) => <CommunityCard post={p} />)}</div>
  )}
  {!tag && !catName && pages > 1 && (
    <nav aria-label="Pagination" class="mt-12 flex items-center justify-between font-sans text-sm">
      {page > 1 ? <a href={`/community/?page=${page - 1}`} rel="prev" class="rounded border border-line bg-surface px-4 py-2">← Newer</a> : <span />}
      <span class="text-muted">Page {page} of {pages}</span>
      {page < pages ? <a href={`/community/?page=${page + 1}`} rel="next" class="rounded border border-line bg-surface px-4 py-2">Older →</a> : <span />}
    </nav>
  )}
</BaseLayout>
