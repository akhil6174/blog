---
/** /me/notices/<id>/ : the full message the admin sent (D-046). Only recipients (and the admin) can open it. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { hasRole } from '../../../lib/auth';
import { noticeFor } from '../../../lib/notices';

export const prerender = false;

const user = Astro.locals.user!;
const id = Number(Astro.params.id);
const n = Number.isInteger(id) && id > 0 ? await noticeFor(id, user.id, hasRole(user, 'admin')) : null;
if (!n) return new Response('Not found', { status: 404 });
const when = n.createdAt.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'long', timeStyle: 'short' });
---

<BaseLayout title={n.title} description="A notice from TrutiAI." noindex>
  <article class="mx-auto max-w-2xl font-sans">
    <p class="text-sm"><a href="/me/notifications/" class="text-muted underline">← Notifications</a></p>
    <p class="mt-4 inline-block rounded-full bg-tint px-3 py-1 text-xs font-semibold text-accent-strong">{n.kind === 'suggestion' ? 'Suggestion' : 'Notice'} from {n.sender}</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight md:text-3xl">{n.title}</h1>
    <p class="mt-1 text-sm text-muted">{when}</p>
    <div class="mt-6 whitespace-pre-line rounded-2xl border border-line bg-surface p-5 font-serif text-lg leading-relaxed" data-testid="notice-body">{n.body}</div>
    {n.link && <p class="mt-5"><a href={n.link} target={n.link.startsWith('/') ? undefined : '_blank'} rel="noopener" class="inline-block rounded-full bg-accent px-5 py-2 font-semibold text-white hover:bg-accent-strong">{n.kind === 'suggestion' ? 'Edit your article' : 'Open the link'} →</a></p>}
    <p class="mt-8 text-sm text-muted">Questions? Reply by email to akhilendrad@trutiai.in.</p>
  </article>
</BaseLayout>
