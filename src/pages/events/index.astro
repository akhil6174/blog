---
/** /events/ : upcoming and past TrutiAI events (D-047). On-demand, edge-cached, refreshed when the admin edits events. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { publicEvents } from '../../lib/events';
import { breadcrumbJsonLd } from '../../lib/seo';

export const prerender = false;

const { upcoming, past } = await publicEvents();
const siteUrl = (Astro.site ?? new URL('https://trutiai.in/')).href;
---

<BaseLayout title="Events: hackathons, workshops and contests" description="Upcoming TrutiAI events for students and developers: hackathons, workshops, writing challenges and talks. All times in India time (IST)." jsonLd={[breadcrumbJsonLd([{ name: 'Home', url: siteUrl }, { name: 'Events', url: `${siteUrl}events/` }])]}>
  <header class="max-w-3xl font-sans">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">Events</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight md:text-4xl">Hackathons, workshops and contests</h1>
    <p class="mt-3 font-serif text-lg text-muted">Join TrutiAI events to learn, build and meet other students. All times are India time (IST).</p>
  </header>

  <section class="mt-10" aria-labelledby="up-title">
    <h2 id="up-title" class="font-sans text-2xl font-bold">Upcoming</h2>
    {upcoming.length ? (
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{upcoming.map((e) => <EventCard e={e} />)}</div>
    ) : (
      <p class="mt-4 rounded-2xl border border-dashed border-line p-6 font-sans text-muted" data-testid="no-upcoming">No upcoming events right now. New events are announced here and to our <a href="/students/campus-ambassadors/" class="underline">campus ambassadors</a> first.</p>
    )}
  </section>

  {past.length > 0 && (
    <section class="mt-14" aria-labelledby="past-title">
      <h2 id="past-title" class="font-sans text-2xl font-bold">Past events</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{past.map((e) => <EventCard e={e} past />)}</div>
    </section>
  )}
</BaseLayout>
