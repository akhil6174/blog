---
/**
 * /join-us : two ways to take part. Contributors just sign in and write; internship applications go through a
 * separate form (/api/apply) and land in Programme admin. Public only while `programme_open` is true.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewBanner from '../../components/PreviewBanner.astro';
import { programmeGate } from '../../lib/programme';

export const prerender = false;
const cfg = await programmeGate(Astro.request.headers);
if (!cfg) return new Response(null, { status: 404 });
if (cfg.preview) Astro.response.headers.set('cache-control', 'private, no-store');
const turnstileSiteKey = process.env.TURNSTILE_SITE_KEY ?? '';
---

<BaseLayout title="Join TrutiAI" description="Become a TrutiAI contributor or apply for a technical writing internship.">
  {cfg.preview && <PreviewBanner />}
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">Join us</h1>
  <p class="mt-3 max-w-2xl font-serif text-lg text-muted">Two ways to write with TrutiAI.</p>

  <div class="mt-8 grid gap-6 font-sans md:grid-cols-2">
    <section class="rounded-lg border border-line bg-surface p-6">
      <h2 class="text-xl font-bold">Become a contributor</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 font-serif text-base">
        <li>Open to students and technology enthusiasts.</li>
        <li>Submit articles; they are published after editorial review.</li>
        <li>Take part in the monthly competition and earn rewards.</li>
        <li>Build a public writing portfolio on your writer page.</li>
      </ul>
      <p class="mt-5"><a href="/signin/?next=/write/" class="rounded bg-accent px-4 py-2 font-semibold text-white">Sign in and start writing</a></p>
      <p class="mt-3 text-sm text-muted"><a href="/campus-writers/" class="underline">How the programme works</a></p>
    </section>

    <section class="rounded-lg border border-line bg-surface p-6">
      <h2 class="text-xl font-bold">Apply for an internship</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 font-serif text-base">
        <li>Technical content writing, research and fact-checking.</li>
        <li>Structured assignments with editorial mentorship.</li>
        <li>Performance review, and a completion certificate when you finish successfully.</li>
      </ul>
      <form id="apply" class="mt-5 grid gap-3 text-sm">
        <input type="hidden" name="track" value="internship" />
        <label class="grid gap-1"><span class="font-semibold">Full name</span><input name="name" required minlength="2" maxlength="80" class="rounded border border-line bg-page px-3 py-2" /></label>
        <label class="grid gap-1"><span class="font-semibold">Email</span><input name="email" type="email" required maxlength="120" class="rounded border border-line bg-page px-3 py-2" /></label>
        <label class="grid gap-1"><span class="font-semibold">College <span class="font-normal text-muted">(optional)</span></span><input name="college" maxlength="100" class="rounded border border-line bg-page px-3 py-2" /></label>
        <label class="grid gap-1"><span class="font-semibold">Topics you want to work on</span><input name="interests" maxlength="200" class="rounded border border-line bg-page px-3 py-2" placeholder="Python, machine learning, cloud" /></label>
        <label class="grid gap-1"><span class="font-semibold">A sample of your writing or code <span class="font-normal text-muted">(link, optional)</span></span><input name="sampleUrl" type="url" maxlength="200" class="rounded border border-line bg-page px-3 py-2" placeholder="https://" /></label>
        <label class="grid gap-1"><span class="font-semibold">Why you want to join</span><textarea name="message" required minlength="30" maxlength="2000" rows="4" class="rounded border border-line bg-page px-3 py-2"></textarea></label>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="compact"></div>}
        <p class="text-xs text-muted">We use these details only to review your application (see the <a href="/privacy/" class="underline">privacy policy</a>).</p>
        <div class="flex items-center gap-3"><button class="rounded bg-accent px-4 py-2 font-semibold text-white">Send application</button><span id="apply-msg" class="text-sm text-muted" role="status"></span></div>
      </form>
    </section>
  </div>
  <script is:inline>
    document.getElementById('apply')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target; const msg = document.getElementById('apply-msg');
      const body = Object.fromEntries(new FormData(f).entries());
      body.turnstileToken = body['cf-turnstile-response'] || ''; delete body['cf-turnstile-response'];
      f.querySelector('button').disabled = true;
      const r = await fetch('/api/apply', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json().catch(() => ({}));
      msg.textContent = r.ok ? (d.message || 'Thank you. We will email you.') : (d.error || 'Could not send.');
      if (r.ok) f.reset(); else f.querySelector('button').disabled = false;
    });
  </script>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
