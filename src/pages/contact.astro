---
/**
 * Contact page (static) with a working form. AdSense checks that a site has real contact details.
 * The form posts to /api/contact (Turnstile + Resend). The email address is also shown in plain text.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';

const turnstileSiteKey = process.env.TURNSTILE_SITE_KEY ?? '';
---

<PageLayout title="Contact" description={`Get in touch with ${SITE.name}: questions, corrections, article ideas, partnerships or press. We reply within two working days.`}>
  <p>
    Questions, corrections, article ideas or partnership requests are all welcome. Email
    <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> or use the form below. We usually reply within two working days.
  </p>

  <form id="contact-form" method="post" action="/api/contact" class="not-prose mt-8 grid gap-5 font-sans" novalidate>
    <div class="grid gap-1.5">
      <label for="name" class="text-sm font-semibold">Your name</label>
      <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" class="rounded border border-line bg-surface px-3 py-2" />
    </div>
    <div class="grid gap-1.5">
      <label for="email" class="text-sm font-semibold">Your email</label>
      <input id="email" name="email" type="email" required maxlength="200" autocomplete="email" class="rounded border border-line bg-surface px-3 py-2" />
    </div>
    <div class="grid gap-1.5">
      <label for="subject" class="text-sm font-semibold">Subject</label>
      <select id="subject" name="subject" class="rounded border border-line bg-surface px-3 py-2">
        <option>General question</option>
        <option>Correction to an article</option>
        <option>Article idea or pitch</option>
        <option>Partnership or advertising</option>
        <option>Report content</option>
      </select>
    </div>
    <div class="grid gap-1.5">
      <label for="message" class="text-sm font-semibold">Message</label>
      <textarea id="message" name="message" required minlength="20" maxlength="4000" rows="6" class="rounded border border-line bg-surface px-3 py-2"></textarea>
    </div>
    <!-- Honeypot: humans never see or fill this field. -->
    <div class="hidden" aria-hidden="true"><label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>

    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>}

    <div class="flex items-center gap-4">
      <button type="submit" class="rounded bg-accent px-5 py-2.5 font-semibold text-white hover:bg-accent-strong disabled:opacity-60">Send message</button>
      <p id="contact-status" class="text-sm text-muted" role="status" aria-live="polite"></p>
    </div>
    <p class="text-xs text-muted">We use your name and email only to reply. See the <a href="/privacy/" class="underline">privacy policy</a>.</p>
  </form>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true; status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok) { status.textContent = 'Thanks, your message is on its way.'; form.reset(); }
        else { status.textContent = data.error || 'Something went wrong. Please email us instead.'; }
      } catch { status.textContent = 'Network error. Please email us instead.'; }
      finally { btn.disabled = false; if (window.turnstile) window.turnstile.reset(); }
    });
  </script>
</PageLayout>
