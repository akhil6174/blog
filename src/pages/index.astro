---
/**
 * Home page (static). Hero with the brand emblem, topics, featured and latest articles (pagination to /page/2/),
 * and a "write with us" band. Works with no articles yet (a short notice in place of the list).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { CATEGORIES, SITE } from '../lib/site';
import { getPublishedPosts, POSTS_PER_PAGE } from '../lib/posts';
import { websiteJsonLd } from '../lib/seo';

const posts = await getPublishedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
const pageItems = rest.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(rest.length / POSTS_PER_PAGE));
const siteUrl = (Astro.site ?? new URL('https://trutiai.in/')).href;

const TOPIC_INFO: Record<string, { blurb: string; icon: string }> = {
  'web-development': { blurb: 'Frameworks, browsers and the web platform, from a first page to production.', icon: 'M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16' },
  'developer-tools': { blurb: 'Editors, the terminal, Git and the tools that make daily work faster.', icon: 'M4 17l6-6-6-6M12 19h8' },
  'cloud-and-hosting': { blurb: 'Deploying and running apps, with free tiers and limits spelled out.', icon: 'M17.5 19a4.5 4.5 0 1 0-1.4-8.78A6 6 0 1 0 6 16.9M7 19h10.5' },
  'ai-for-developers': { blurb: 'Using models and AI APIs in real projects, with measured results.', icon: 'M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM9 9h6v6H9z' },
  'careers-in-tech': { blurb: 'Interviews, portfolios, internships and learning paths for students.', icon: 'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 13h18' },
};
const counts = new Map<string, number>();
for (const p of posts) if (p.data.category) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---

<BaseLayout jsonLd={[websiteJsonLd(siteUrl)]} full>
  <section class="relative overflow-hidden border-b border-line bg-tint">
    <svg class="pointer-events-none absolute -right-24 -top-10 hidden h-[34rem] w-[34rem] text-accent opacity-[0.07] md:block" viewBox="0 0 565 565" aria-hidden="true">
      <g transform="translate(0 87)" fill="currentColor">
        <path d="M 17 21 L 17 95 L 145 96 L 145 270 L 218 198 L 219 97 L 221 95 L 307 95 L 311 100 L 367 236 L 421 376 L 549 376 L 549 208 L 483 209 L 484 313 L 481 316 L 478 312 L 460 264 L 360 21 Z" />
        <path d="M 172 292 L 170 292 L 145 317 L 146 376 L 184 375 L 217 340 Z" />
        <path d="M 265 198 L 263 198 L 173 290 L 218 338 L 215 343 L 218 338 L 291 262 Z" />
      </g>
    </svg>
    <div class="relative mx-auto max-w-6xl px-4 py-16 md:py-24">
      <p class="font-sans text-sm font-semibold text-accent">An independent tech publication from India</p>
      <h1 class="mt-4 max-w-3xl font-sans text-4xl font-bold leading-[1.1] tracking-tight text-balance md:text-6xl">
        Practical writing on software, tools and <span class="text-accent">the craft of building things.</span>
      </h1>
      <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-muted md:text-xl">{SITE.description}</p>
      <div class="mt-8 flex flex-wrap gap-3 font-sans">
        <a href="/articles/" class="rounded-full bg-accent px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-accent-strong">Explore articles</a>
        <a href="/signin/?next=/write/" class="rounded-full border border-line bg-surface px-6 py-3 font-semibold text-ink transition hover:border-accent hover:text-accent">Write for {SITE.name}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:py-20" aria-labelledby="topics-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="topics-title" class="font-sans text-2xl font-bold tracking-tight md:text-3xl">Browse by topic</h2>
      <a href="/articles/" class="font-sans text-sm font-semibold text-accent hover:underline">All articles →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {CATEGORIES.map((c) => {
        const info = TOPIC_INFO[c.slug];
        const n = counts.get(c.slug) ?? 0;
        return (
          <a href={`/articles/?category=${c.slug}`} class="group flex flex-col rounded-2xl border border-line bg-surface p-5 font-sans transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-tint text-accent transition group-hover:bg-accent group-hover:text-white">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={info?.icon ?? 'M4 6h16M4 12h16M4 18h10'} /></svg>
            </span>
            <span class="mt-4 font-semibold text-ink">{c.name}</span>
            <span class="mt-1 text-sm leading-relaxed text-muted">{info?.blurb}</span>
            {n > 0 && <span class="mt-3 text-xs font-medium text-accent">{n} {n === 1 ? 'article' : 'articles'}</span>}
          </a>
        );
      })}
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16">
    {featured ? (
      <>
        <section aria-labelledby="featured-title" class="rounded-3xl border border-line bg-surface p-6 md:p-10">
          <h2 id="featured-title" class="mb-6 font-sans text-xs font-semibold uppercase tracking-wider text-accent">Featured</h2>
          <PostCard post={featured} featured />
        </section>
        {pageItems.length > 0 && (
          <section aria-labelledby="latest-title" class="mt-16">
            <h2 id="latest-title" class="mb-8 font-sans text-2xl font-bold tracking-tight md:text-3xl">Latest articles</h2>
            <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">{pageItems.map((p) => <PostCard post={p} />)}</div>
            <Pagination current={1} total={totalPages} url={(n) => (n === 1 ? '/' : `/page/${n}/`)} />
          </section>
        )}
      </>
    ) : (
      <section aria-labelledby="latest-title" class="rounded-3xl border border-dashed border-line px-6 py-12 text-center font-sans">
        <h2 id="latest-title" class="text-xl font-bold">The first articles are on their way</h2>
        <p class="mx-auto mt-2 max-w-lg text-muted">New tutorials and comparisons are being written and edited now. Follow the RSS feed to read them first.</p>
        <a href="/rss.xml" class="mt-5 inline-block rounded-full border border-line px-5 py-2 font-semibold text-ink hover:border-accent hover:text-accent">RSS feed</a>
      </section>
    )}
  </div>

  <section class="bg-accent">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 font-sans text-white md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Have something you built and want to explain?</h2>
        <p class="mt-2 text-white/85">Sign in with Google, write in a clean editor, and every article is reviewed by an editor before it goes live.</p>
      </div>
      <a href="/signin/?next=/write/" class="shrink-0 rounded-full bg-white px-6 py-3 font-semibold text-accent-strong transition hover:bg-tint">Start writing</a>
    </div>
  </section>
</BaseLayout>
