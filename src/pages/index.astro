---
/**
 * Home page (pre-rendered static file, free and unlimited to serve).
 * Phase 0 placeholder: proves the design tokens and the deploy pipeline. Phase 1 replaces it with the real home.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout>
  <header class="border-b border-line bg-surface">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
      <a href="/" class="font-sans text-xl font-bold tracking-tight">{SITE.name}</a>
      <nav aria-label="Primary" class="flex gap-6 font-sans text-sm text-muted">
        <a href="/" class="hover:text-ink">Home</a>
        <a href="/api/health" class="hover:text-ink">Status</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-4 py-16">
    <section class="mx-auto max-w-measure">
      <p class="font-sans text-sm font-semibold uppercase tracking-wide text-accent">Phase 0 · Foundation</p>
      <h1 class="mt-3 font-sans text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        {SITE.tagline}
      </h1>
      <div class="prose-article mt-8 text-ink">
        <p>
          {SITE.description} The site runs on Cloudflare's free plan with Astro: editorial pages are served as static
          files, and only community features run code.
        </p>
        <p class="mt-4 text-muted">
          First articles arrive in Phase 2. Until then this page exists to prove the build, the design tokens and the
          deploy pipeline.
        </p>
      </div>
      <p class="mt-10 font-sans text-sm text-muted">
        Written by {SITE.author.name}. Open <a class="underline hover:text-ink" href="/api/health">/api/health</a> to see
        which Cloudflare services are connected.
      </p>
    </section>
  </main>

  <footer class="mt-24 border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-2 px-4 py-8 font-sans text-sm text-muted">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>Legal pages (About, Contact, Privacy, Terms) are added in Phase 1.</span>
    </div>
  </footer>
</BaseLayout>
